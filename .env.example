# =============================================================================
# 视频处理流水线 - 环境变量配置模板
# =============================================================================
# 用法：
#   1. 复制此文件:  cp .env.example .env
#   2. 修改 .env 中的值以适配你的 Excel 结构和平台
#   3. 运行脚本:    python process_videos.py  (或 node process_videos.js)
#
# 核心思路：只需提供 Excel + 列名映射 + 平台 URL 模板，
# 脚本自动完成 下载 → 转码 → 语音识别 → AI 关键词归纳 全流程。
# =============================================================================
#
# ── 配置项变更权限说明 ──────────────────────────────────────────────────────
# 为方便修改，每个配置项用以下标记标注变更规则：
#
#   【自由】= 值可随意变更为任意合法内容（路径、开关、数字、字符串等）
#   【调序】= 值来自一个固定集合，可以：增减条目 / 调整顺序 / 改优先级
#            但不能使用集合之外的值（否则脚本无法识别）
#   【关联】= 值需与脚本内约定的 Key 名一致（通常跟随 PLATFORM_PRIORITY）
#   【固定】= 除非 Excel 列名或脚本内部逻辑改变，否则不应修改
#
# =============================================================================


# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║  一、输入与字段映射（必设 — 不设置无法运行）                             ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

# ── 1.1  输入文件 ───────────────────────────────────────────────────────────
# 【自由】任意合法的 Excel 文件路径（相对或绝对）
EXCEL_FILE=data/export_2026-06-10_split.xlsx

# ── 1.2  处理的 Sheet ───────────────────────────────────────────────────────
# 【自由】逗号分隔的 sheet 名称列表，可增删、调序；不指定则处理所有 sheet
VIDEO_SHEETS=YouTube视频,普诺赛中文站

# ── 1.3  Excel 字段映射 ─────────────────────────────────────────────────────
# 以下变量值 = 你的 Excel 表头列名。
# 【固定】除非 Excel 列名发生变化，否则不应修改
#
# ════════════ 必填列 ════════════
COL_ID=extra.id                  # 唯一标识（行匹配 + 文件命名）
COL_TITLE=title                  # 视频标题
COL_CONTENT=content              # 输出列：识别文本写入此列
COL_KEYWORDS=keywords           # 输出列：AI 分析结果（关键词归纳）写入此列
#
# ════════════ 平台视频 ID 列 ════════════
# 至少配置一个，列值会替换 URL 模板中的占位符
COL_TENCENTVID=extra.tencentVid
COL_BILIBILIBVID=extra.bilibiliBvid
COL_YOUTUBEID=extra.youtubeId
COL_YOUKUID=extra.youkuId


# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║  二、平台与下载（必设 — 决定从哪些平台下载及如何下载）                   ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

# ── 2.1  平台优先级 ─────────────────────────────────────────────────────────
# 【调序】可选值来自以下固定集合（与上方平台列名后缀对应）:
#   bilibili   = B 站 BV 号
#   youtube    = YouTube 视频 ID
#   tencent    = 腾讯视频 VID
#   youku      = 优酷视频 ID
#
# 你可以：
#   1. 调整顺序 → 排前面的平台优先下载
#   2. 增减条目 → 只保留你需要的平台
#   ✗ 不能使用集合之外的值（如 "tiktokId"、"douyinId" 等未定义的 key）
PLATFORM_PRIORITY=bilibili,youtube,tencent,youku

# ── 2.2  平台 URL 模板 ──────────────────────────────────────────────────────
# 【关联】模板中的 {占位符} 必须与 PLATFORM_PRIORITY 中的 key 名一致
#         如 {youtube} 会被 COL_YOUTUBEID 列的值替换
# 【自由】URL 本身可随意修改（例如从 youtu.be 改为 www.youtube.com/watch?v=）
#
# 前缀规则: TENCENT=腾讯视频  BILIBILI=B站  YOUTUBE=YouTube  YOUKU=优酷
TENCENT_URL_TPL=https://v.qq.com/x/page/{tencent}.html
BILIBILI_URL_TPL=https://www.bilibili.com/video/{bilibili}/
YOUTUBE_URL_TPL=https://youtu.be/{youtube}
YOUKU_URL_TPL=https://v.youku.com/v_show/id_{youku}.html

# ── 2.3  平台通用配置变量参考 ───────────────────────────────────────────────
# 以下变量对每个平台分别配置，前缀 = 平台前缀（BILIBILI / YOUTUBE / TENCENT / YOUKU）
# 详细说明见下方各平台专属配置段（2.5 ~ 2.8）
#
# {前缀}_COOKIE_FILE            【自由】cookie 文件路径（留空=不使用）
# {前缀}_COOKIES_FROM_BROWSER   【自由】chrome / firefox / edge / 留空
#                                 优先于 COOKIE_FILE，直接从浏览器读 cookie
#                                 ⚠️ Windows Chromium 系浏览器 DPAPI 解密已知失败
# {前缀}_PROXY                  【自由】代理地址 (http:// 或 socks5://)
#                                 如 Clash Verge 默认 http://127.0.0.1:7897
#                                 ⚠️ 脚本会自动给 yt-dlp 及其 node/ejs 子进程注入
#                                    HTTPS_PROXY 环境变量
# {前缀}_USER_AGENT             【自由】自定义 User-Agent (留空=yt-dlp 默认)
#                                 含特殊字符需用双引号包裹
# {前缀}_FORMAT                 【自由】yt-dlp 下载格式
#                                 默认 bestvideo+bestaudio/best
# {前缀}_CONCURRENT_FRAGMENTS   【自由】并发分片数 (加速下载, 仅 B站)
# {前缀}_JS_RUNTIMES            【自由】JS 运行时 (node/deno, YouTube n-sig 求解)
# {前缀}_REMOTE_COMPONENTS      【自由】远程组件 (如 ejs:github, YouTube 必需)
# {前缀}_REFERER                【自由】Referer 请求头 (如 B站)
# {前缀}_URL_TPL                【自由】URL 模板 (见 2.2 "平台 URL 模板")

# ── 2.4  输出目录（相对于项目根目录）────────────────────────────────────────
# 【自由】任意合法目录名
DOWNLOADS_DIR=output/downloads    # 下载的视频文件
TRANSCODED_DIR=output/transcoded  # 转码后的音频文件
REPORTS_DIR=output/reports        # 执行报告 JSON
COOKIES_DIR=cookies               # 站点 cookie 文件

# ── 2.5  Bilibili 配置 ──────────────────────────────────────────────────────
# 方案 A（推荐）: 直接从 Firefox 浏览器读 cookie，yt-dlp 能稳定解密
BILIBILI_COOKIES_FROM_BROWSER=firefox    # 【自由】firefox / chrome / edge
# 方案 B（备用）: 从文件读取 cookie
# BILIBILI_COOKIE_FILE=cookies/bilibili.txt   # 【自由】cookie 文件路径（方案 A 启用时此行无效）
# 【自由】自定义 User-Agent (含特殊字符需用双引号包裹)
BILIBILI_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/149.0.0.0 Safari/537.36"
BILIBILI_REFERER=https://www.bilibili.com/     # 【自由】
BILIBILI_CONCURRENT_FRAGMENTS=4               # 【自由】并发分片数
BILIBILI_FORMAT=bestvideo[height<=720]+bestaudio/bestvideo+bestaudio/best  # 【自由】

# ── 2.6  YouTube 配置 ───────────────────────────────────────────────────────
# 方案 A（推荐）: 直接从 Firefox 浏览器读 cookie，yt-dlp 能稳定解密
YOUTUBE_COOKIES_FROM_BROWSER=firefox           # 【自由】firefox / chrome / edge
# 方案 B（备用）: 从文件读取 cookie，但需定期更新（YouTube 约 48h 轮换 cookie）
#   Chrome 用 "Get cookies.txt LOCALLY" 扩展导出 → cookies/youtube.txt
# YOUTUBE_COOKIE_FILE=cookies/youtube.txt      # 【自由】cookie 文件路径
#   ⚠️ Windows Chromium 系浏览器 DPAPI 解密已知失败，不建议用 --cookies-from-browser chrome
YOUTUBE_PROXY=http://127.0.0.1:7897           # 【自由】代理地址 (Clash Verge 默认 7897, v2rayN 默认 10809)
# 【自由】自定义 User-Agent (含特殊字符需用双引号包裹)
YOUTUBE_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/149.0.0.0 Safari/537.36"
YOUTUBE_JS_RUNTIMES=node                      # 【自由】解 n-sig 的 JS 运行时
YOUTUBE_REMOTE_COMPONENTS=ejs:github          # 【自由】YouTube n-sig 需要的远程组件
YOUTUBE_FORMAT=bestvideo[height<=720]+bestaudio/bestvideo+bestaudio/best  # 【自由】

# ── 2.7  腾讯视频配置 ───────────────────────────────────────────────────────
# 腾讯视频通常不需要 cookie
TENCENT_COOKIE_FILE=                           # 【自由】
TENCENT_USER_AGENT=                            # 【自由】

# ── 2.8  优酷配置 ───────────────────────────────────────────────────────────
YOUKU_COOKIE_FILE=                             # 【自由】
YOUKU_USER_AGENT=                              # 【自由】


# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║  三、AI 关键词分析（必设 — 启用时需配置 API）                            ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

# ── 3.1  开关 ───────────────────────────────────────────────────────────────
# 【自由】是否启用 AI 分析环节（true/false），在语音识别之后执行
AI_ENABLED=true

# ── 3.2  API 连接 ───────────────────────────────────────────────────────────
# 【自由】OpenAI 兼容 API 配置（⚠️ 请勿提交真实 API Key 到此文件）
AI_API_KEY=your-api-key-here
AI_BASE_URL=https://your-api-host/v1
AI_MODEL=your-model-name

# ── 3.3  推理参数 ───────────────────────────────────────────────────────────
# 【自由】AI 推理温度 (0.0~2.0, 越低越确定/保守, 越高越随机/创意)
AI_TEMPERATURE=0.3

# ── 3.4  提示词模板 ─────────────────────────────────────────────────────────
# 【关联】{content} 占位符会被识别文本替换，必须保留
# 【自由】提示词内容可随意修改
#
# 设计要点：
#   · 让模型统计中英文字符占比判定语言类型，阈值 60%，避免"一个中文就判中文"
#   · 不限定关键词数量，全面提取；中文在前、英文在后，统一逗号分隔
#   · 核心防错：中文关键词绝不翻译成英文，英文关键词绝不翻译成中文
#
AI_PROMPT_TPL=你是多语言内容分析专家。对以下视频转录文本提取搜索关键词。\n\n请遵循以下规则：\n\n【语言判定】\n- 先统计内容的中文字符数和英文字母数\n- 中文占比 > 60% → 按纯中文处理\n- 英文占比 > 60% → 按纯英文处理\n- 两者都不满足 → 按中英混合处理\n\n【纯中文内容】\n- 提取全部有价值的关键词，不限定数量，用英文逗号分隔\n- 关键词必须全部是中文，绝对不能翻译成英文\n- 优先提取 2-8 字的有实际搜索价值的短语\n- 避免单字和泛词（如"的""是""这个""一个"等）\n\n【纯英文内容】\n- 提取全部有价值的关键词，用英文逗号分隔\n- 关键词必须全部是英文，绝对不能翻译成中文\n- 优先提取 2-8 词的有实际搜索价值的短语\n- 避免单字和泛词（如"the""this""is""a"等）\n\n【中英混合内容】\n- 提取全部有价值的关键词，不限定数量\n- 中文关键词必须是中文，英文关键词必须是英文，互不翻译\n- 中文关键词放在前面，英文关键词放在后面，统一用英文逗号分隔\n\n通用规则：全面覆盖内容主题，不遗漏不重复，不要凭空编造内容中没有的概念。这是内容：{content}


# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║  四、外部工具路径（选设 — 通常无需修改）                                 ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

# 【自由】可改为工具的绝对路径或自定义命令名
YTDLP=yt-dlp                     # yt-dlp 命令行工具
FFMPEG=ffmpeg                    # ffmpeg 转码工具
FFPROBE=ffprobe                  # ffprobe 媒体信息探测


# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║  五、语音识别（选设 — 默认远程 whisper.cpp server）                      ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

# ── 5.1  后端模式 ───────────────────────────────────────────────────────────
# 【自由】backend: "service" 或 "local"（任选其一）
# · service = 远程 whisper.cpp server（推荐，默认）
# · local   = 本地 openai-whisper CLI
# WHISPER_BACKEND=service
WHISPER_BACKEND=local

# ── 5.2  服务端模式（backend=service）───────────────────────────────────────
WHISPER_SERVICE=http://localhost:9588   # 【自由】服务地址
#
# 识别参数：
WHISPER_TEMPERATURE=0.0           # 【自由】推理温度 (0.0~1.0, 越低越确定)
WHISPER_TEMPERATURE_INC=0.2       # 【自由】温度增量 (fallback 时升温步长)
WHISPER_RESPONSE_FORMAT=json      # 【自由】返回格式 (json / text / srt / vtt)
#
# 服务端模型（二选一）：
#   ① 留空 → 使用服务器当前已加载的模型
#   ② 指定路径 → 首次识别时自动 POST /load 切换到此模型
WHISPER_SERVICE_MODEL=D:/Programs/memo-ai/models/ggml-medium.bin   # 【自由】模型文件路径
#
# ℹ️  服务端模式的语言由服务管理后台设定，API 不支持在请求中指定

# ── 5.3  本地模式（backend=local）─ 取消注释并注释 5.2 即可切换 ─────────────
WHISPER_MODEL=medium               # 【自由】tiny / base / small / medium / large
WHISPER_DEVICE=cpu                 # 【自由】cpu 或 cuda
WHISPER_LANGUAGE=zh                # 【自由】空=自动检测, zh/en/ja 等指定语言

# ── 5.4  Whisper 模型对比参考 ───────────────────────────────────────────────
# ══════════════════════════════════════════════════════════════════════════════
#  模型     参数量    磁盘占用   内存占用    相对速度  中文WER   适用场景
#  ──────── ──────── ───────── ────────── ──────── ──────── ──────────────────
#  tiny       39M     ~75 MB    ~150 MB     10x      ~30%+   快速测试、实时流式
#                                                            转录、极低资源设备
#
#  base       74M    ~145 MB    ~290 MB      7x      ~25%    低资源环境、嵌入式
#                                                            设备、非关键场景
#
#  small     244M    ~465 MB    ~930 MB      4x      ~18%    平衡速度与精度、中
#                                                            等算力设备首选
#
#  medium    769M    ~1.5 GB    ~3.0 GB      2x      ~12%    较高精度需求、批量
#                                                            处理、内容审核
#
#  large-v3 1550M    ~3.0 GB    ~6.0 GB      1x      ~5-7%   最高精度、生产环境
#                                                            正式发布、学术研究
#
#  ── 选择建议 ──
#  · 日常批量处理 → medium：2 倍速度换取 12% 词错率，性价比最高
#  · 最终发布质量 → large-v3：中文 WER 仅 5-7%，繁体/方言/口音覆盖更好
#  · 低显存设备   → small：930 MB 内存即可运行，适合 4GB VRAM 设备
#  · 快速验证     → tiny/base：秒级响应，适合调试流程和参数
#  · 离线场景     → 使用 local 模式 + 本地模型文件
#
#  注：WER（词错率）为多语言测试集基准值，实际表现取决于音频质量和口音。
#      内存占用为 fp16 推理估算值，int8 量化后减半。


# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║  六、转码参数（选设 — whisper 优化，通常无需修改）                       ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

TRANSCODE_EXT=.wav               # 输出音频格式

# ↓ 完整转码参数链（按流水线顺序）
TRANSCODE_ARGS=-vn -map_metadata -1 -map 0:a:0 -af loudnorm=I=-16:TP=-1.5:LRA=11:linear=true,aresample=resampler=soxr:osr=16000:osf=s16:dither_method=shibata -ac 1 -c:a pcm_s16le
#
# ↓ 参数详解（按执行顺序）:
#
#   -vn                跳过视频流 → 仅处理音频，大幅加速
#   -map_metadata -1   剥离所有元数据 → 减小文件体积
#   -map 0:a:0         只取第一个音频流 → 避免多音轨视频选错轨道
#   -af "..."          音频滤镜链（见下方逐项说明）
#   -ac 1              输出单声道 → whisper 只需单声道
#   -c:a pcm_s16le     编码器: WAV PCM 16-bit signed little-endian
#
# ↓ 音频滤镜链详解（-af 参数，从左到右依次执行）:
#
#   ① loudnorm=I=-16:TP=-1.5:LRA=11:linear=true
#      EBU R128 响度归一化（单次线性模式）:
#      · I=-16   → 目标响度 -16 LUFS（广播标准，whisper 最优输入电平）
#      · TP=-1.5 → 真峰值限制 -1.5 dBTP（防止削波失真）
#      · LRA=11  → 响度范围 11 LU（典型语音动态范围）
#      · linear=true → 线性归一化，单次处理无需预扫描，快速且适合语音
#
#   ② aresample=resampler=soxr:osr=16000:osf=s16:dither_method=shibata
#      soxr 高质量重采样器:
#      · resampler=soxr       → 比 ffmpeg 默认 swr 精度更高，抗混叠更优
#      · osr=16000            → 输出采样率 16kHz（whisper 原生采样率）
#      · osf=s16              → 输出 16-bit signed integer
#      · dither_method=shibata → 芝畑抖动算法，24/32-bit→16-bit 量化时消除截断失真
#
# ═══════════════════════ 备选方案 ═══════════════════════
# 如果不需要响度归一化，改为下面这行:
# TRANSCODE_ARGS=-vn -map_metadata -1 -map 0:a:0 -af aresample=resampler=soxr:osr=16000:osf=s16:dither_method=shibata -ac 1 -c:a pcm_s16le
