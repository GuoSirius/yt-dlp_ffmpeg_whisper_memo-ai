# =============================================================================
# 视频处理流水线 - 环境变量配置模板
# =============================================================================
# 用法：
#   1. 复制此文件:  cp .env.example .env
#   2. 修改 .env 中的值以适配你的 Excel 结构和平台
#   3. 运行脚本:    python process_videos.py
#
# 核心思路：只需提供 Excel + 列名映射 + 平台 URL 模板，
# 脚本自动完成 下载 → 转码 → 语音识别 全流程。
# =============================================================================

# ── 输入文件 ────────────────────────────────────────────────────────────────
# Excel 文件路径（相对于项目根目录，或绝对路径）
EXCEL_FILE=export_2026-06-10_split.xlsx

# ── 输出目录（相对于项目根目录）─────────────────────────────────────────────
DOWNLOADS_DIR=downloads          # 下载的视频文件
TRANSCODED_DIR=transcoded        # 转码后的音频文件
REPORTS_DIR=reports              # 执行报告 JSON
COOKIES_DIR=cookies              # 站点 cookie 文件

# ── 外部工具 ────────────────────────────────────────────────────────────────
YTDLP=yt-dlp                     # yt-dlp 命令行工具
FFMPEG=ffmpeg                    # ffmpeg 转码工具
FFPROBE=ffprobe                  # ffprobe 媒体信息

# ── Whisper 语音识别 ───────────────────────────────────────────────────────
# WHISPER_BACKEND=service          # 后端: "service"(whisper.cpp server) 或 "local"(openai-whisper CLI)
# WHISPER_MODEL=base               # 模型名: tiny/base/small/medium/large
# WHISPER_DEVICE=cpu               # 设备 (仅 backend=local): cpu 或 cuda
# WHISPER_LANGUAGE=                # 语言 (仅 backend=local): 空=多语言自动检测, 如 zh/en/ja 等
#   (service 模式由 whisper.cpp server 自动检测语言，无需配置)
# WHISPER_SERVICE_MODEL=           # 模型文件路径 (仅 backend=service): 如 models/ggml-base.bin
#   留空则跳过 /load，使用服务器当前已加载的模型

# 远程服务模式 (默认)
WHISPER_BACKEND=service
WHISPER_MODEL=base
WHISPER_SERVICE=http://localhost:9588

# 本地模式 (取消下方注释并注释上方三行即可切换)
# WHISPER_BACKEND=local
# WHISPER_MODEL=base
# WHISPER_DEVICE=cpu
# WHISPER_LANGUAGE=zh

# ── 转码参数 ────────────────────────────────────────────────────────────────
TRANSCODE_EXT=.wav               # 输出音频格式
TRANSCODE_ARGS=-ar 16000 -ac 1 -c:a pcm_s16le   # ffmpeg 参数（空格分隔）

# ── Excel 字段映射 ──────────────────────────────────────────────────────────
# 按你的 Excel 结构修改以下列名，脚本会用这些列来定位数据
#
# 【必填列】
COL_ID=extra.id                  # 唯一标识（行匹配 + 文件命名）
COL_TITLE=title                  # 视频标题
COL_CONTENT=content              # 输出列：识别文本写入此列
#
# 【平台视频 ID 列】至少配置一个，列值会替换 URL 模板中的占位符
COL_TENCENTVID=extra.tencentVid
COL_BILIBILIBVID=extra.bilibiliBvid
COL_YOUTUBEID=extra.youtubeId
COL_YOUKUID=extra.youkuId

# ── 处理的 Sheet ────────────────────────────────────────────────────────────
# 逗号分隔，只处理这些 sheet（如不指定则处理所有 sheet）
VIDEO_SHEETS=YouTube视频,普诺赛中文站

# ── 平台优先级 ──────────────────────────────────────────────────────────────
# 逗号分隔，排前面的优先尝试。可选: bilibiliBvid youtubeId tencentVid youkuId
# 一行数据有多个平台 ID 时，按此顺序选第一个非空的
PLATFORM_PRIORITY=bilibiliBvid,youtubeId,tencentVid,youkuId

# ── 平台 URL 模板 ───────────────────────────────────────────────────────────
# 模板中的 {占位符} = 平台 key（见上方 PLATFORM_PRIORITY），会被对应列的值替换
# 前缀规则: TENCENT=腾讯视频 BILIBILI=B站 YOUTUBE=YouTube YOUKU=优酷
TENCENT_URL_TPL=https://v.qq.com/x/page/{tencentVid}.html
BILIBILI_URL_TPL=https://www.bilibili.com/video/{bilibiliBvid}/
YOUTUBE_URL_TPL=https://youtu.be/{youtubeId}
YOUKU_URL_TPL=https://v.youku.com/v_show/id_{youkuId}.html

# ── Bilibili 配置 ───────────────────────────────────────────────────────────
BILIBILI_COOKIE_FILE=cookies/bilibili.txt     # cookie 文件路径（留空=不使用）
BILIBILI_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/149.0.0.0 Safari/537.36
BILIBILI_REFERER=https://www.bilibili.com/
BILIBILI_CONCURRENT_FRAGMENTS=4               # 并发分片数（加速下载）
BILIBILI_FORMAT=bestvideo[height<=720]+bestaudio/bestvideo+bestaudio/best

# ── YouTube 配置 ────────────────────────────────────────────────────────────
YOUTUBE_COOKIE_FILE=cookies/youtube.txt
YOUTUBE_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/149.0.0.0 Safari/537.36
YOUTUBE_JS_RUNTIMES=node                      # 解 n-sig 的 JS 运行时
YOUTUBE_REMOTE_COMPONENTS=ejs:github          # YouTube 需要的远程组件
YOUTUBE_FORMAT=bestvideo[height<=720]+bestaudio/bestvideo+bestaudio/best

# ── 腾讯视频配置 ────────────────────────────────────────────────────────────
# 腾讯视频通常不需要 cookie
TENCENT_COOKIE_FILE=
TENCENT_USER_AGENT=

# ── 优酷配置 ────────────────────────────────────────────────────────────────
YOUKU_COOKIE_FILE=
YOUKU_USER_AGENT=
